{
  "manifest_version": 3,
  "name": "Video transcripts",
  "version": "1.0.2",
  "description": "Transcribe English audio or translate between Italian and English locally. Keep your text in a saved video library.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabCapture", "offscreen", "sidePanel", "nativeMessaging", "storage", "unlimitedStorage"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Open video transcripts"},
  "side_panel": {"default_path": "panel.html"}
}
